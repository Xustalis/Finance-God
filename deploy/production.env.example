# 复制为 deploy/.env.production 并填写真实值。不要提交该生产文件。
APP_NAME=Finance-God
APP_ENV=production
APP_DEBUG=false
SQL_ECHO=false
CORS_ORIGINS=https://finance-god.example.com

POSTGRES_PASSWORD=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PandaData 是生产行情主源，用户名与密码均为必填。
PANDA_DATA_USERNAME=
PANDA_DATA_PASSWORD=
PANDA_DATA_BASE_URL=

# 业务文本能力可配置以下提供方；产品 Multi-Agent 与学习 worker 还必须配置 ARK。
# DeepSeek 模型由管理端白名单配置；生产凭据在这里提供。
# DEEPSEEK_API_KEY=replace-with-production-key

# 或配置 StepFun；用户画像模型固定为 step-3.5-flash-2603。
# STEPFUN_API_KEY=replace-with-production-key
# 同一密钥用于文本与 stepaudio-2.5-realtime 实时语音。

# ARK 必须同时提供凭据与模型标识。
ARK_API_KEY=replace-with-production-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=replace-with-production-model

# 常驻自迭代 worker 使用同一 ARK/PandaData 配置；只把客观验证结果注入产品 Agent。
FINANCE_GOD_KNOWLEDGE_DIR=/app/artifacts/knowledge
FINANCE_GOD_LEARNING_INTERVAL_SECONDS=900
FINANCE_GOD_LEARNING_SYMBOLS=000300.SH
FINANCE_GOD_LEARNING_MARKET=1
FINANCE_GOD_LEARNING_BACKTEST=1
FINANCE_GOD_LEARNING_TRANSACTION_COST_BPS=10

VITE_WORKBENCH_ORIGIN=
WORKBENCH_ORIGIN=
