BRIDGE_ADMIN_TOKEN=replace-with-a-long-random-token
INJECTIVE_DB_PASSWORD=replace-with-a-different-long-random-password
BRIDGE_DATABASE_URL=postgresql+asyncpg://injective_bridge:change-me@db:5432/finance_god_injective
BRIDGE_NETWORK=testnet
BRIDGE_MARKET_TICKER=INJ/USDT
BRIDGE_MAX_NOTIONAL=25
BRIDGE_MAX_PRICE_DEVIATION_BPS=100
BRIDGE_PLAN_TTL_SECONDS=300
BRIDGE_MAX_ACTIVE_ORDERS=1
BRIDGE_BROADCAST_TIMEOUT_SECONDS=30
BRIDGE_AUTO_CREATE_SCHEMA=false

# Execution remains unavailable until a dedicated funded Testnet key is supplied.
INJECTIVE_PRIVATE_KEY_HEX=
INJECTIVE_SUBACCOUNT_INDEX=0

# Finance-God is never contacted unless this flag is explicitly enabled and an
# import endpoint is called. The Bridge never logs in or refreshes this token.
FINANCE_GOD_SYNC_ENABLED=false
FINANCE_GOD_BASE_URL=http://host.docker.internal:8000
FINANCE_GOD_READ_TOKEN=
